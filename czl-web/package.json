{
  "name": "czl-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy:local": "npm run build && npm run start",
    "server": "node server/index.js",
    "dev:server": "NODE_ENV=development node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:server\" \"npm run dev\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "gray-matter": "4.0.3",
    "highlight.js": "^11.8.0",
    "marked": "^5.1.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^10.0.4",
    "vite": "^5.4.19"
  }
}
